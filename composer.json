{
    "name": "itfixit/laravel-theme",
    "description": "Theme management for Laravel 13 applications, including themed views, layouts, assets, breadcrumbs, and middleware.",
    "keywords": ["laravel", "theme", "layout", "asset", "widget"],
    "homepage": "https://github.com/itfixit/laravel-theme",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "It Fix It Ltd.",
            "email": "sales@itfixit.bg"
        },
        {
            "name": "Teepluss",
            "email": "admin@laravel.in.th"
        },
        {
            "name": "FaCuZ",
            "email": "info@indis.com.ar"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/console": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "Facuz\\Theme\\": "src/"
        },
        "classmap": [
            "src/Exceptions.php"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Facuz\\Theme\\ThemeServiceProvider"
            ],
            "aliases": {
                "Theme": "Facuz\\Theme\\Facades\\Theme"
            }
        }
    }
}
